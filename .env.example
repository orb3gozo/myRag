# Copy to .env and edit. Environment variables override values in .env.
# Relative paths resolve against the repository root.

# RAG engine: llamaindex (langchain comes later)
RAG_ENGINE=llamaindex
# Base URL of the OpenAI-compatible LLM server
LLM_BASE_URL=http://localhost:1234/v1
# Model identifier on the LLM server
LLM_MODEL=qwen3-1.7b
# API key placeholder; local servers don't check it
LLM_API_KEY=lm-studio
# Sampling temperature for answers
LLM_TEMPERATURE=0.1
# Append /no_think to prompts to turn off Qwen3 reasoning
LLM_NO_THINK=true
# Embedding backend: fastembed (local) or openai (OpenAI-compatible server)
EMBED_PROVIDER=fastembed
# Embedding model name
EMBED_MODEL=intfloat/multilingual-e5-small
# Embedding server URL, used only when EMBED_PROVIDER=openai
EMBED_BASE_URL=http://localhost:1234/v1
# Tokens per chunk
CHUNK_SIZE=400
# Tokens shared by consecutive chunks
CHUNK_OVERLAP=50
# Number of chunks retrieved per query
TOP_K=4
# LanceDB storage directory
LANCEDB_PATH=backend/storage/lancedb
# Directory holding the Markdown corpus
CORPUS_DIR=data/fastapi-es
# Directory holding the example code that corpus pages include
DOCS_SRC_DIR=data/fastapi-docs_src
